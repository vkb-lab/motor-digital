{
  "version": "1.0.0",
  "system": "K-OS",
  "checkpoint": "038",
  "module": "command_center_action_router",
  "purpose": "Criar roteador central de acoes controladas para auditoria, refresh de relatorios, abertura operacional e bloqueio de acoes perigosas.",
  "router_policy": {
    "command_center_local_only": true,
    "raw_command_state_committed": false,
    "sanitized_reports_only": true,
    "external_send_enabled": false,
    "external_publish_enabled": false,
    "automatic_message_enabled": false,
    "arbitrary_shell_command_allowed": false,
    "allowlist_only_execution": true,
    "dry_run_default": true,
    "approval_required_for_medium_high_risk": true,
    "dangerous_actions_blocked": true,
    "manual_approval_required": true,
    "audit_log_deletion_allowed": false
  },
  "risk_levels": [
    "low",
    "medium",
    "high",
    "critical"
  ],
  "allowed_action_domains": [
    "security",
    "analytics",
    "cockpit",
    "commercial",
    "customer_ops",
    "support",
    "product",
    "roadmap",
    "git_local"
  ],
  "blocked_actions": [
    "run_arbitrary_shell_command",
    "delete_files",
    "delete_audit_logs",
    "delete_local_secrets",
    "publish_external_content",
    "send_external_message",
    "call_external_provider",
    "push_without_security_scan",
    "commit_without_security_scan",
    "modify_license_without_approval",
    "activate_customer_without_gate",
    "export_customer_identifiable_data"
  ],
  "required_gates_before_action_execution": [
    "action_exists_in_allowlist",
    "risk_level_classified",
    "dry_run_completed",
    "approval_present_if_required",
    "operator_reason_present_if_required",
    "audit_event_recorded"
  ],
  "next_checkpoint": "039 - K-Agent Orchestration Queue Core"
}