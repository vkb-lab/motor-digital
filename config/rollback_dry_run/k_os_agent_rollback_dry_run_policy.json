{
  "version": "1.0.0",
  "system": "K-OS",
  "checkpoint": "055",
  "module": "agent_rollback_dry_run_simulator_core",
  "purpose": "Simular rollback sem executar rollback real, sem alterar arquivos, sem apagar dados, respeitando o gate de release e registrando evidencia auditavel.",
  "rollback_dry_run_policy": {
    "dry_run_local_only": true,
    "raw_dry_run_state_committed": false,
    "sanitized_reports_only": true,
    "external_send_enabled": false,
    "external_publish_enabled": false,
    "automatic_message_enabled": false,
    "dry_run_executes_rollback": false,
    "dry_run_deletes_data": false,
    "dry_run_modifies_files": false,
    "dry_run_runs_git_reset": false,
    "dry_run_runs_git_force_push": false,
    "rollback_release_gate_required": true,
    "rollback_plan_required": true,
    "incident_lockdown_required": true,
    "forensics_bundle_required": true,
    "ledger_record_required": true,
    "simulation_may_be_safely_blocked": true,
    "human_approval_required_for_real_execution": true,
    "manual_approval_required": true,
    "audit_log_deletion_allowed": false
  },
  "dry_run_statuses": [
    "draft",
    "simulated",
    "simulated_blocked",
    "validated",
    "blocked",
    "archived"
  ],
  "blocked_actions": [
    "execute_rollback_now",
    "delete_evidence",
    "delete_ledger_record",
    "delete_forensics_bundle",
    "delete_memory",
    "modify_files",
    "git_reset_hard",
    "git_force_push",
    "send_external_message",
    "publish_external_content",
    "call_external_provider",
    "release_quarantine_without_review",
    "commit_raw_dry_run_state",
    "export_secret",
    "export_raw_memory"
  ],
  "required_gates_before_rollback_dry_run": [
    "rollback_release_record_exists",
    "rollback_plan_exists",
    "rollback_plan_hash_exists",
    "incident_lockdown_exists",
    "forensics_bundle_available",
    "ledger_record_available",
    "execution_evidence_hash_available",
    "simulation_steps_created",
    "no_real_rollback_executed",
    "no_file_modification_performed",
    "no_data_deletion_performed",
    "dry_run_hash_created",
    "audit_event_recorded"
  ],
  "next_checkpoint": "056 - K-Agent Rollback Execution Final Gate Core"
}