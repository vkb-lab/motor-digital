{
  "version": "1.0.0",
  "system": "K-OS",
  "checkpoint": "040",
  "module": "agent_runtime_supervisor_core",
  "purpose": "Supervisionar runtime de agentes, registrar heartbeat, detectar agentes travados, monitorar fila multiagente e gerar watchdog operacional.",
  "runtime_policy": {
    "agent_runtime_local_only": true,
    "raw_runtime_data_committed": false,
    "sanitized_reports_only": true,
    "external_send_enabled": false,
    "external_publish_enabled": false,
    "automatic_message_enabled": false,
    "arbitrary_agent_execution_allowed": false,
    "agent_permission_matrix_required": true,
    "agent_queue_required": true,
    "command_center_router_required": true,
    "heartbeat_required": true,
    "watchdog_enabled": true,
    "stale_agent_blocking_enabled": true,
    "dry_run_default": true,
    "manual_approval_required": true,
    "audit_log_deletion_allowed": false
  },
  "runtime_statuses": [
    "registered",
    "idle",
    "active",
    "waiting_approval",
    "stale",
    "blocked",
    "failed",
    "completed",
    "offline"
  ],
  "health_levels": [
    "healthy",
    "attention",
    "blocked"
  ],
  "allowed_agent_ids": [
    "k_atlas_engineer",
    "k_uni_cockpit",
    "k_os_git_bridge",
    "k_os_security_firewall",
    "k_os_schema_guard",
    "marketplace_ia_agent",
    "future_multimodal_connector"
  ],
  "watchdog_rules": {
    "heartbeat_max_age_minutes": 30,
    "max_failed_runtime_events": 3,
    "max_blocked_tasks_before_attention": 1,
    "max_stale_agents_before_blocked": 1
  },
  "blocked_actions": [
    "execute_agent_without_runtime_registration",
    "execute_agent_without_heartbeat",
    "continue_stale_agent",
    "bypass_agent_queue",
    "bypass_command_center",
    "delete_runtime_audit_logs",
    "commit_raw_runtime_state",
    "send_external_message",
    "publish_external_content",
    "call_external_provider"
  ],
  "required_gates_before_runtime_execution": [
    "agent_registered",
    "agent_allowed",
    "heartbeat_recent",
    "queue_task_valid",
    "permission_matrix_available",
    "command_center_available",
    "operator_approval_if_required",
    "audit_event_recorded"
  ],
  "next_checkpoint": "041 - K-Agent Execution Ledger and Replay Core"
}