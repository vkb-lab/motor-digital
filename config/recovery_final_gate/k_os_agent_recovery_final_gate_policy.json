{
  "version": "1.0.0",
  "system": "K-OS",
  "checkpoint": "065",
  "module": "agent_recovery_final_gate_core",
  "purpose": "Registrar gate final antes de qualquer stub/manual futuro de recovery, validando dry-run, gate, plano, readiness e governanca sem executar recovery real.",
  "final_gate_policy": {
    "final_gate_local_only": true,
    "raw_final_gate_state_committed": false,
    "sanitized_reports_only": true,
    "external_send_enabled": false,
    "external_publish_enabled": false,
    "automatic_message_enabled": false,
    "final_gate_executes_recovery": false,
