    "final_gate_deletes_data": false,
    "final_gate_modifies_target_files": false,
    "final_gate_runs_git_reset": false,
    "final_gate_runs_git_force_push": false,
    "final_gate_executes_shell_commands": false,
    "recovery_dry_run_required": true,
    "recovery_gate_required": true,
    "recovery_plan_required": true,
    "readiness_matrix_required": true,
    "governance_summary_required": true,
    "manual_approval_required": true,
    "audit_log_deletion_allowed": false
