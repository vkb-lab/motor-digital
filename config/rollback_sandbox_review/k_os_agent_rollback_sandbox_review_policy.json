{
  "version": "1.0.0",
  "system": "K-OS",
  "checkpoint": "059",
  "module": "agent_rollback_sandbox_report_operator_review_core",
  "purpose": "Gerar relatorio executivo da sandbox de rollback, consolidar blockers e registrar revisao do operador sem executar rollback real.",
  "review_policy": {
    "review_local_only": true,
    "raw_review_state_committed": false,
    "sanitized_reports_only": true,
    "external_send_enabled": false,
    "external_publish_enabled": false,
    "automatic_message_enabled": false,
    "review_executes_rollback": false,
    "review_deletes_data": false,
    "review_modifies_target_files": false,
    "review_runs_git_reset": false,
    "review_runs_git_force_push": false,
    "sandbox_record_required": true,
    "sandbox_hash_required": true,
    "manual_stub_required": true,
    "final_gate_required": true,
    "dry_run_required": true,
    "release_gate_required": true,
    "rollback_plan_required": true,
    "operator_review_required": true,
    "manual_approval_required": true,
    "audit_log_deletion_allowed": false
  },
  "allowed_review_decisions": [
    "acknowledge_blocked",
    "request_changes",
    "archive_review"
