    "review_recorded",
    "changes_requested",
    "archived",
    "validated",
    "blocked"
  ],
  "blocked_actions": [
    "execute_rollback_now",
    "delete_evidence",
    "delete_ledger_record",
    "delete_forensics_bundle",
    "delete_memory",
